---
// Biblioteket: ALT vi har vist av nyheter, forskning og boktips, søkbart — pluss
// favorittmerkede gåter og quizspørsmål. Stjernen er en favorittmarkering (et filter), ikke inngangsbilletten:
// en studie du ikke merket, er fortsatt søkbar her.
//
// Filtrering og søk skjer SERVER-SIDE via URL-parametre
// (?q=&type=&kategori=&tag=&sort=&favoritt=&side=). Tre grunner: det virker uten JS,
// URL-ene blir delbare og bokmerkbare («kosthold-studier om protein»), og det skalerer
// forbi noen tusen oppføringer.
import Base from '../layouts/Base.astro';
import SaveButton from '../components/SaveButton.astro';
import SaveRuntime from '../components/SaveRuntime.astro';
import { queryItems, tagCounts, TYPE_LABELS, TYPE_EMOJI, isDue } from '../lib/saved.js';
import { libraryItems, libraryCounts, resolveIndex } from '../lib/library.js';
import { RESEARCH_CATEGORIES, formatDateNo } from '../lib/briefings.js';
import { writingEnabled, isAuthed } from '../lib/auth.js';

const PAGE_SIZE = 40;

const url = Astro.url;
const q = (url.searchParams.get('q') || '').trim();
const category = url.searchParams.get('kategori') || '';
const type = url.searchParams.get('type') || '';
const tag = url.searchParams.get('tag') || '';
const sort = url.searchParams.get('sort') || 'nyest';
const favorite = url.searchParams.get('favoritt') === '1';
const page = Math.max(1, Number(url.searchParams.get('side')) || 1);

const items = await libraryItems();
const results = queryItems(items, { q, type, category, tag, sort, favorite });
const tags = tagCounts(items);
const counts = libraryCounts(items);
const canPin = writingEnabled();
const canEdit = canPin && isAuthed(Astro.cookies);

const pages = Math.max(1, Math.ceil(results.length / PAGE_SIZE));
const current = Math.min(page, pages);
const shown = results.slice((current - 1) * PAGE_SIZE, current * PAGE_SIZE);

// Pin-knappen trenger indeks for gåter/quiz — slås opp kun for det som faktisk vises.
const indexFor = new Map(
  await Promise.all(
    shown.filter((it) => it.type !== 'study').map(async (it) => [it.id, await resolveIndex(it)]),
  ),
);

// Studier har en kjent kategoriliste; gåter/quiz bærer sin egen etikett («Nivå 2»,
// «Norsk samfunn»), så den vises rå.
const catLabel = (it) =>
  it.type === 'study'
    ? RESEARCH_CATEGORIES.find((c) => c.id === it.category)?.label || 'Øvrig'
    : it.category || TYPE_LABELS[it.type];
const catEmoji = (it) =>
  it.type === 'study'
    ? RESEARCH_CATEGORIES.find((c) => c.id === it.category)?.emoji || '🔬'
    : TYPE_EMOJI[it.type];

// Bygger en URL der én parameter endres og resten beholdes — så filtre kan kombineres.
// Sidetallet nullstilles alltid: treffmengden er en annen etter et filterbytte.
const withParam = (key, value) => {
  const p = new URLSearchParams(url.search);
  if (value) p.set(key, value);
  else p.delete(key);
  if (key !== 'side') p.delete('side');
  const s = p.toString();
  return s ? `/lagret?${s}` : '/lagret';
};

const usedCategories = RESEARCH_CATEGORIES.filter((c) => items.some((it) => it.category === c.id));
const filtered = Boolean(q || category || tag || type || favorite);
const exportQuery = url.search ? `${url.search}&` : '?';
---

<Base title="Bibliotek">
  <section class="saved-head">
    <h1 class="page-title">Bibliotek</h1>
    <p class="muted">
      {items.length === 0
        ? 'Ingenting her ennå.'
        : `${items.length} oppføringer · ${counts.favorite} favoritt${counts.favorite === 1 ? '' : 'er'}${filtered ? ` · ${results.length} treff` : ''}`}
    </p>
    <p class="muted saved-lede">
      Alt som har vært vist av nyheter, forskning og boktips ligger her og er søkbart —
      også det du ikke merket. ★ er favorittmerking: den kan du filtrere på, og kun
      favoritter får notat, tagger og «Dagens repetisjon».
    </p>
  </section>

  {items.length > 0 && (
    <nav class="typetabs" aria-label="Utvalg">
      <a class:list={['typetab', !type && !favorite && 'typetab--on']} href="/lagret">
        Alle <span class="tagchip__n">{items.length}</span>
      </a>
      <a class:list={['typetab', favorite && 'typetab--on']} href={withParam('favoritt', favorite ? '' : '1')}>
        ★ Favoritter <span class="tagchip__n">{counts.favorite}</span>
      </a>
      {Object.entries(TYPE_LABELS).filter(([t]) => counts[t] > 0).map(([t, label]) => (
        <a class:list={['typetab', type === t && 'typetab--on']} href={withParam('type', type === t ? '' : t)}>
          {TYPE_EMOJI[t]} {label} <span class="tagchip__n">{counts[t]}</span>
        </a>
      ))}
    </nav>
  )}

  {items.length > 0 && (
    <form class="saved-filters" method="get" action="/lagret">
      <input
        class="saved-search" type="search" name="q" value={q}
        placeholder="Søk i tittel, innhold, notat og tagger…" aria-label="Søk"
      />
      <select class="saved-select" name="kategori" aria-label="Kategori">
        <option value="">Alle kategorier</option>
        {usedCategories.map((c) => (
          <option value={c.id} selected={category === c.id}>{c.emoji} {c.label}</option>
        ))}
      </select>
      <select class="saved-select" name="sort" aria-label="Sortering">
        <option value="nyest" selected={sort === 'nyest'}>Nyeste briefing</option>
        <option value="eldst" selected={sort === 'eldst'}>Eldste briefing</option>
        <option value="lagret" selected={sort === 'lagret'}>Sist favorittmerket</option>
        <option value="tittel" selected={sort === 'tittel'}>Tittel</option>
      </select>
      {tag && <input type="hidden" name="tag" value={tag} />}
      {type && <input type="hidden" name="type" value={type} />}
      {favorite && <input type="hidden" name="favoritt" value="1" />}
      <button class="btn" type="submit">Filtrer</button>
      {filtered && <a class="btn btn--ghost" href="/lagret">Nullstill</a>}
    </form>
  )}

  {results.length > 0 && (
    <p class="muted exportbar">
      Eksporter {filtered ? 'utvalget' : 'alt'}:
      <a href={`/api/eksport${exportQuery}format=md`}>markdown</a> ·
      <a href={`/api/eksport${exportQuery}format=json`}>JSON</a>
    </p>
  )}

  {tags.length > 0 && (
    <div class="tagcloud">
      {tags.map(([t, n]) => (
        <a class:list={['tagchip', tag === t && 'tagchip--on']} href={withParam('tag', tag === t ? '' : t)}>
          {t} <span class="tagchip__n">{n}</span>
        </a>
      ))}
    </div>
  )}

  {results.length === 0 ? (
    <div class="card empty">
      {items.length === 0 ? (
        <>
          <p><strong>Biblioteket er tomt.</strong></p>
          <p class="muted">
            Det fylles av seg selv: hvert nyhetspunkt på
            <a href="https://nyheter.modr.no">nyheter.modr.no</a>, hver studie på
            <a href="https://forskning.modr.no">forskning.modr.no</a> og hvert boktips fra
            «Dagens inspirasjon» havner her og blir søkbart. Trykk ☆ for å favorittmerke —
            da kan du skrive et notat, tagge den, og få den tilbake som «Dagens repetisjon».
          </p>
        </>
      ) : (
        <p class="muted">Ingen treff. <a href="/lagret">Nullstill filtrene</a>.</p>
      )}
    </div>
  ) : (
    <div class="research-grid research-grid--wide">
      {shown.map((it) => (
        <article class:list={['card', 'study', it.favorite && 'study--fav']} id={it.id}>
          <div class="saved-meta">
            <span class="badge">{catEmoji(it)} {catLabel(it)}</span>
            <span class="muted saved-date">
              {it.favorite && isDue(it) && <span class="due-dot" title="Forfalt til repetisjon">🔁</span>}
              {it.date ? formatDateNo(it.date, { day: 'numeric', month: 'short', year: 'numeric' }) : ''}
            </span>
          </div>
          <h2 class="study__title">
            {it.url ? <a href={it.url} target="_blank" rel="noopener">{it.title}</a> : it.title}
          </h2>
          {it.journal && <p class="muted saved-journal">{it.journal}</p>}

          {canPin && (it.type === 'study' ? it.url : indexFor.get(it.id) !== null || it.favorite) && (
            <div class="study__actions">
              <SaveButton
                type={it.type}
                date={it.date}
                url={it.type === 'study' ? it.url : null}
                index={it.type === 'study' ? null : indexFor.get(it.id)}
                id={it.favorite ? it.id : null}
                saved={it.favorite}
              />
            </div>
          )}

          {it.favorite && (
            <div class="saved-note" data-note-for={it.id}>
              {it.note ? <p class="saved-note__text">{it.note}</p> : null}
              {(it.tags || []).length > 0 && (
                <div class="saved-tags">
                  {it.tags.map((t) => <a class="tagchip tagchip--sm" href={withParam('tag', t)}>{t}</a>)}
                </div>
              )}
              {canEdit && (
                <button class="linkbtn" type="button" data-edit={it.id}>
                  {it.note || (it.tags || []).length ? 'Rediger notat' : '+ Legg til notat'}
                </button>
              )}
            </div>
          )}

          {(it.snapshot?.parts || []).length > 0 && (
            <details class="saved-details">
              <summary>{it.type === 'study' ? 'Vis studien' : 'Vis innholdet'}</summary>
              <div class="study__parts">
                {it.snapshot.parts.map((p) => (
                  <div class="study__part">
                    <div class="study__label">{p.label}</div>
                    <div class="study__text" set:html={p.html} />
                  </div>
                ))}
              </div>
              {it.date && (
                <p class="muted saved-origin">
                  Fra briefingen <a href={it.type === 'study'
                    ? `https://forskning.modr.no/b/${it.date}`
                    : `https://nyheter.modr.no/b/${it.date}`}>{formatDateNo(it.date)}</a>
                </p>
              )}
            </details>
          )}
        </article>
      ))}
    </div>
  )}

  {pages > 1 && (
    <nav class="pager" aria-label="Sider">
      {current > 1
        ? <a class="btn btn--ghost" href={withParam('side', String(current - 1))}>← Forrige</a>
        : <span />}
      <span class="muted">Side {current} av {pages}</span>
      {current < pages
        ? <a class="btn btn--ghost" href={withParam('side', String(current + 1))}>Neste →</a>
        : <span />}
    </nav>
  )}

  {canEdit && (
    <dialog class="pinauth" id="noteedit">
      <form method="dialog" class="pinauth__form">
        <h2 class="pinauth__title">Notat og tagger</h2>
        <p class="pinauth__hint">Hvorfor merket du denne? Om seks måneder er det dette som gir listen verdi.</p>
        <textarea class="pinauth__input" id="note-text" rows="4" placeholder="Hvorfor er denne viktig?"></textarea>
        <input class="pinauth__input" id="note-tags" list="taglist" placeholder="Tagger, komma­separert (f.eks. protein, styrke)" />
        <datalist id="taglist">{tags.map(([t]) => <option value={t} />)}</datalist>
        <div class="pinauth__actions">
          <button value="cancel" class="btn btn--ghost" type="submit">Avbryt</button>
          <button value="ok" class="btn" type="submit">Lagre</button>
        </div>
      </form>
    </dialog>
  )}

  {/* Stjernene på denne siden bruker samme runtime som forsknings-/nyhetssidene:
      toggling, kodeord-dialog og angre-toast ved avmerking. */}
  {canPin && <SaveRuntime authed={canEdit} />}
</Base>

<script is:inline>
  (() => {
    // Kun notat/tagg-redigering her — stjernen håndteres av SaveRuntime.
    const dlg = document.getElementById('noteedit');
    if (!dlg) return;
    const text = document.getElementById('note-text');
    const tagsInput = document.getElementById('note-tags');
    let editing = null;

    document.addEventListener('click', (e) => {
      const edit = e.target.closest('[data-edit]');
      if (!edit) return;
      editing = edit.dataset.edit;
      const box = document.querySelector(`[data-note-for="${CSS.escape(editing)}"]`);
      text.value = box?.querySelector('.saved-note__text')?.textContent?.trim() || '';
      tagsInput.value = [...(box?.querySelectorAll('.saved-tags .tagchip') || [])]
        .map((a) => a.textContent.trim()).join(', ');
      dlg.showModal();
    });

    dlg.addEventListener('close', async () => {
      if (dlg.returnValue !== 'ok' || !editing) return;
      const res = await fetch('/api/lagret', {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: editing, note: text.value, tags: tagsInput.value }),
      }).then((r) => r.json()).catch(() => ({ ok: false }));
      editing = null;
      if (res.ok) location.reload();
    });
  })();
</script>
