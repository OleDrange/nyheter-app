---
// Dagens inspirasjon — 1–2 podcast-råd + 1–2 boktips fra learning-feltet
// (kuratert av Claude i den daglige kjøringen). Ren HTML; stjernen på boktipsene
// styres av den delte SaveRuntime som BriefingView allerede inkluderer.
//
// Boktipsene indekseres i biblioteket uansett (library.js) — stjernen er kun
// favorittmerking. Podkast-rådene er knyttet til én episode og har ingen egen
// side å finnes igjen på; de er derfor ikke pinnbare.
import SaveButton from './SaveButton.astro';
import { buildId } from '../lib/saved.js';
const { learning, date = '', canPin = false, saved = new Set() } = Astro.props;
const podcasts = learning.podcasts || [];
const books = learning.books || [];
---

<div class="cards-grid">
  {podcasts.length > 0 && (
    <article class="card learn-card">
      <header class="section-card__head">
        <span class="section-card__emoji" aria-hidden="true">🎧</span>
        <h3 class="section-card__title">Fra podkastene</h3>
      </header>
      <ul class="learn-list">
        {podcasts.map((p) => (
          <li>
            <p class="learn-item__tip">{p.tip}</p>
            <p class="learn-item__src">
              <a href={p.url} target="_blank" rel="noopener">{p.episode}</a>
              <span class="learn-item__meta"> · {p.podcast}</span>
            </p>
          </li>
        ))}
      </ul>
    </article>
  )}
  {books.length > 0 && (
    <article class="card learn-card">
      <header class="section-card__head">
        <span class="section-card__emoji" aria-hidden="true">📚</span>
        <h3 class="section-card__title">Boktips</h3>
      </header>
      <ul class="learn-list">
        {books.map((bk, i) => (
          <li>
            <div class="learn-item__head">
              <p class="learn-item__book">
                {bk.title}
                {bk.author && <span class="learn-item__meta"> — {bk.author}</span>}
                {bk.year && <span class="learn-item__meta"> ({bk.year})</span>}
              </p>
              {canPin && (
                <SaveButton
                  type="book" date={date} index={i} compact
                  id={buildId('book', bk)}
                  saved={saved.has(buildId('book', bk))}
                />
              )}
            </div>
            {bk.why && <p class="learn-item__tip">{bk.why}</p>}
          </li>
        ))}
      </ul>
    </article>
  )}
</div>
